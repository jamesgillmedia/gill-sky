{
  "email": "imjamesgill@gmail.com",
  "poem": [
    "I am Gill",
    "I am James",
    "I am an artist",
    "a Cree voice rising",
    "weaving sound into the unseen",
    "Indigenous kin, my culture\u2019s pulse",
    "visual arts",
    "Fine art and music",
    "are rivers I swim, a daily drift",
    "a lifelong hum",
    "Artistry a starfield I chase",
    "All my relations,",
    "in all my creations",
    "their breath in every chord I make and everything",
    "I create."
  ],
